# Copy to .env.local and adjust. All values are optional.

# Owner-preview / demonstration mode. Defaults to "true" when unset.
# Set to "false" for the public launch build.
NEXT_PUBLIC_DEMO_MODE=true

# The real public web address, once the owners have chosen a domain.
# Enables canonical URLs, Open Graph image URLs and the XML sitemap.
# Leave empty until the domain is confirmed - never guess it.
NEXT_PUBLIC_SITE_URL=

# An approved form-delivery endpoint (for example a Formspree/Basin/Getform
# form URL, or the school's own backend) that accepts a JSON POST.
# Only used when demo mode is OFF. When empty, the online form is replaced
# by call-the-school options so no enquiry can silently disappear.
NEXT_PUBLIC_ENQUIRY_ENDPOINT=

# Sub-path the site is served from, e.g. "/Barneys-place-" for the GitHub Pages
# project site. Leave empty for a site at a domain root. The Pages workflow
# sets this automatically.
NEXT_PUBLIC_BASE_PATH=
